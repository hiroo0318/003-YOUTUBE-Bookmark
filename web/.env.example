# 채널담 환경변수 — .env.local로 복사해 값을 채운다. .env.local은 git에 올리지 않는다.

# Supabase (공개용 값)
NEXT_PUBLIC_SUPABASE_URL=https://ultrjuxpudxlfllovcqq.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_972WNRyatAa2xYoRhKlc_A_uKxewYnB

# Supabase secret 키(sb_secret_… 또는 service_role). 서버 전용 — 절대 NEXT_PUBLIC_ 접두어를 붙이지 않는다.
SUPABASE_SECRET_KEY=

# YouTube Data API v3 키. 서버 전용.
YOUTUBE_API_KEY=

# 최초 부모가 될 Google 이메일
FIRST_PARENT_EMAIL=

# Vercel Cron 호출 확인용 비밀값(임의의 긴 문자열). Vercel 환경변수에도 같은 이름으로 넣는다.
CRON_SECRET=

# 웹 푸시(VAPID) 키 한 쌍: `npx web-push generate-vapid-keys`로 만든다. 공개 키만 NEXT_PUBLIC_ 접두어를 붙인다.
NEXT_PUBLIC_VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
# (선택) 푸시 서비스에 알릴 연락처. 비우면 mailto:FIRST_PARENT_EMAIL을 쓴다.
VAPID_SUBJECT=
